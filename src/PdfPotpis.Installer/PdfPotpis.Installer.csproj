<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>PDFPotpis-Setup</AssemblyName>
    <RootNamespace>PdfPotpis.Installer</RootNamespace>
    <ApplicationIcon>..\..\assets\PdfPotpis.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="..\..\assets\PdfPotpis.ico" Link="Assets\PdfPotpis.ico" />
  </ItemGroup>

  <!-- Only embed payload when explicitly requested (release/installer publish).
       Keeps the IDE/solution from loading the large staged PdfPotpis.exe. -->
  <ItemGroup Condition="'$(EmbedAppPayload)' == 'true' And Exists('AppPayload')">
    <Content Include="AppPayload\**\*" Exclude="AppPayload\.gitkeep">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <TargetPath>AppPayload\%(RecursiveDir)%(Filename)%(Extension)</TargetPath>
      <Link>AppPayload\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </Content>
  </ItemGroup>

</Project>
