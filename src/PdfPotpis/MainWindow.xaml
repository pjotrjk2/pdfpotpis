<Window x:Class="PdfPotpis.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PDFPotpis"
        Height="800" Width="1100"
        MinHeight="500" MinWidth="800"
        Background="{StaticResource AppBg}"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Menu DockPanel.Dock="Top" Background="{StaticResource PanelBg}">
            <MenuItem Header="_Fajl">
                <MenuItem Header="_Otvori..." Click="Open_Click" InputGestureText="Ctrl+O"/>
                <MenuItem Header="_Sačuvaj" Click="Save_Click" InputGestureText="Ctrl+S" Name="MenuSave"/>
                <MenuItem Header="Sačuvaj _kao..." Click="SaveAs_Click" Name="MenuSaveAs"/>
                <Separator/>
                <MenuItem Header="_Izađi" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="_Potpis">
                <MenuItem Header="_Potpiši dokument..." Click="Sign_Click" Name="MenuSign"/>
                <MenuItem Header="_Otkaži postavljanje" Click="CancelPlacement_Click" Name="MenuCancelPlacement" IsEnabled="False"/>
            </MenuItem>
            <MenuItem Header="_Pomoć">
                <MenuItem Header="_O aplikaciji" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <ToolBarTray DockPanel.Dock="Top">
            <ToolBar Background="{StaticResource PanelBg}">
                <Button Content="Otvori" Click="Open_Click"/>
                <Button Content="Sačuvaj" Click="Save_Click" Name="BtnSave"/>
                <Button Content="Sačuvaj kao" Click="SaveAs_Click" Name="BtnSaveAs"/>
                <Separator/>
                <Button Content="Potpiši" Click="Sign_Click" Name="BtnSign"
                        Background="{StaticResource Accent}" Foreground="{StaticResource AccentText}"/>
                <Button Content="Potvrdi potpis" Click="ConfirmSign_Click" Name="BtnConfirmSign"
                        IsEnabled="False" Visibility="Collapsed"/>
                <Button Content="Otkaži" Click="CancelPlacement_Click" Name="BtnCancelPlacement"
                        IsEnabled="False" Visibility="Collapsed"/>
            </ToolBar>
        </ToolBarTray>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource PanelBg}">
            <StatusBarItem>
                <TextBlock Name="StatusText" Text="Spremno. Otvorite PDF fajl."/>
            </StatusBarItem>
        </StatusBar>

        <Grid>
            <ScrollViewer Name="PdfScroll"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          Background="#D9D4C8">
                <StackPanel Name="PageHost" Margin="24" HorizontalAlignment="Center"/>
            </ScrollViewer>

            <Border Name="PlacementHint"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Center"
                    Margin="0,12,0,0"
                    Padding="14,8"
                    Background="#E61F4D3A"
                    CornerRadius="4"
                    Visibility="Collapsed">
                <TextBlock Foreground="White" FontSize="13"
                           Text="Prevucite okvir potpisa na željeno mesto, zatim kliknite „Potvrdi potpis“."/>
            </Border>
        </Grid>
    </DockPanel>
</Window>
