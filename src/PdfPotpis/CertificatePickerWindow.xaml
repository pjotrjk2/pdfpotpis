<Window x:Class="PdfPotpis.CertificatePickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Izbor sertifikata"
        Height="420" Width="640"
        WindowStartupLocation="CenterOwner"
        Background="#F3F0E8"
        ResizeMode="NoResize">
    <DockPanel Margin="16">
        <TextBlock DockPanel.Dock="Top"
                   Text="Izaberite sertifikat za digitalni potpis (npr. sa lične karte)."
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"
                   FontSize="14"/>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Potpiši" Width="110" Height="32" IsDefault="True" Click="Ok_Click" Margin="0,0,8,0"
                    Background="#1F4D3A" Foreground="#F7F4EC"/>
            <Button Content="Otkaži" Width="110" Height="32" IsCancel="True" Click="Cancel_Click"/>
        </StackPanel>

        <ListView Name="CertList">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Ime" Width="180" DisplayMemberBinding="{Binding DisplayName}"/>
                    <GridViewColumn Header="Izdavalac" Width="160" DisplayMemberBinding="{Binding Issuer}"/>
                    <GridViewColumn Header="Važi do" Width="90" DisplayMemberBinding="{Binding ValidUntil}"/>
                    <GridViewColumn Header="Serijski broj" Width="140" DisplayMemberBinding="{Binding Serial}"/>
                </GridView>
            </ListView.View>
        </ListView>
    </DockPanel>
</Window>
