<Window x:Class="PdfPotpis.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="O aplikaciji — PDFPotpis"
        Height="420" Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#F3F0E8">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="PDFPotpis"
                   FontFamily="Georgia"
                   FontSize="32"
                   FontWeight="SemiBold"
                   Foreground="#1C2A1F"/>

        <ScrollViewer Grid.Row="1" Margin="0,18,0,18" VerticalScrollBarVisibility="Auto">
            <TextBlock TextWrapping="Wrap"
                       FontFamily="Segoe UI"
                       FontSize="14"
                       LineHeight="22"
                       Foreground="#2A2A2A">
                <Run Text="PDFPotpis je lokalna Windows aplikacija za pregled i digitalno potpisivanje PDF dokumenata."/>
                <LineBreak/><LineBreak/>
                <Run Text="Svi dokumenti i sertifikati obrađuju se isključivo na vašem računaru. Aplikacija ne šalje podatke na internet, ne čuva dokumente na udaljenim serverima i ne prikuplja telemetriju."/>
                <LineBreak/><LineBreak/>
                <Run Text="Digitalni potpis koristi sertifikat sa vaše lične karte (ili drugi sertifikat iz Windows skladišta). Privatni ključ ostaje na kartici / u sistemskom skladištu."/>
                <LineBreak/><LineBreak/>
                <Run Text="Pregled PDF fajlova radi u bezbednom režimu — JavaScript i ugrađene skripte se ne izvršavaju."/>
            </TextBlock>
        </ScrollViewer>

        <Button Grid.Row="2"
                Content="Zatvori"
                Width="110"
                Height="32"
                HorizontalAlignment="Right"
                Click="Close_Click"/>
    </Grid>
</Window>
